[Unit]
Description=FollowBot radio bridge (RF control -> Cube over USB)
After=multi-user.target

[Service]
Type=simple
User=maarslab
WorkingDirectory=/home/maarslab
ExecStart=/usr/bin/python3 -u /home/maarslab/radio_bridge.py
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
